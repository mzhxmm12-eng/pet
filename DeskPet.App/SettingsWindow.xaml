<Window x:Class="DeskPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPet 设置"
        Icon="Assets/AppIcon.ico"
        Width="320"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="宠物大小" />
        <ComboBox x:Name="ScaleBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
            <ComboBoxItem Content="1x" Tag="1" />
            <ComboBoxItem Content="1.5x" Tag="1.5" />
            <ComboBoxItem Content="2x" Tag="2" />
            <ComboBoxItem Content="3x" Tag="3" />
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="动画速度" />
        <ComboBox x:Name="SpeedBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
            <ComboBoxItem Content="慢" Tag="0.75" />
            <ComboBoxItem Content="标准" Tag="1" />
            <ComboBoxItem Content="快" Tag="1.25" />
        </ComboBox>

        <CheckBox x:Name="ClickThroughBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10" Content="点击穿透" />
        <CheckBox x:Name="FeedingBox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10" Content="允许文件投喂" />
        <CheckBox x:Name="ConfirmBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10" Content="投喂前确认" />

        <TextBlock Grid.Row="5"
                   Grid.ColumnSpan="2"
                   Foreground="#666"
                   TextWrapping="Wrap"
                   Text="文件投喂会把拖到宠物身上的文件移入系统回收站，不会永久删除。关闭确认后会直接移入回收站。" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="72" Margin="0,0,8,0" Content="取消" IsCancel="True" />
            <Button Width="72" Content="保存" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
